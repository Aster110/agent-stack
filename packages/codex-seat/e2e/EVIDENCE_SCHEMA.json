{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cc-mesh/codex-seat/evidence/1",
  "title": "codex-seat E2E EvidenceRecord",
  "description": "每个 E2E case（含 --mutate 变异对照）落一份。TS 镜像：src/contracts.ts EvidenceRecord。evidenceReallyRan() 三证据：wallMs>0、events 非空、env.appServer=real 时 rollout 增长（real-idle 免第三条：本档设计上零 turn）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["case", "nonce", "startedAt", "wallMs", "events", "rolloutBytesBefore", "rolloutBytesAfter", "assertions", "mutation", "notes", "passed", "lane", "phase", "env", "contractVersion", "codexVersion", "hostname", "instanceId"],
  "properties": {
    "case": { "type": "string", "pattern": "^E(0[1-9]|1[0-9]|2[01])$" },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{4,64}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "wallMs": { "type": "number", "minimum": 0 },
    "events": {
      "type": "object",
      "description": "事件类型 → 次数（EngineEvent.type 或 raw JSON-RPC method）",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "rolloutBytesBefore": { "type": ["integer", "null"], "minimum": 0 },
    "rolloutBytesAfter": { "type": ["integer", "null"], "minimum": 0 },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "pass", "actual", "expected"],
        "properties": {
          "name": { "type": "string" },
          "pass": { "type": "boolean" },
          "actual": {},
          "expected": {}
        }
      }
    },
    "mutation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fault", "expectedRed", "actualRed"],
          "properties": {
            "fault": {
              "type": ["string", "null"],
              "description": "FaultName 逗号串（同 CODEX_SEAT_FAULT），或 external；合法名单见 src/contracts.ts FAULT_NAMES",
              "pattern": "^(external|[a-z0-9-]+(,[a-z0-9-]+)*)$"
            },
            "expectedRed": { "type": "boolean" },
            "actualRed": { "type": "boolean" },
            "note": { "type": "string" }
          }
        }
      ]
    },
    "notes": { "type": "string" },
    "passed": { "type": "boolean" },
    "lane": { "type": "string", "enum": ["A", "B", "C"] },
    "phase": { "type": "string", "enum": ["unit", "integration", "e2e", "soak", "manual"] },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relay", "appServer"],
      "properties": {
        "relay": { "type": "string", "enum": ["real", "fake", "none"] },
        "appServer": {
          "type": "string",
          "enum": ["real", "real-idle", "fake", "none"],
          "description": "real=真引擎且本档跑过模型 turn（必须有 rollout 增长）；real-idle=真引擎但本档设计上零 turn（免 rollout，墙钟/事件计数照旧）；fake=FakeAppServerClient；none=没有引擎参与"
        }
      }
    },
    "contractVersion": { "type": "string" },
    "codexVersion": { "type": ["string", "null"] },
    "hostname": { "type": "string" },
    "instanceId": { "type": ["string", "null"] }
  }
}
